#!/usr/bin/env bash
#
# Runs the quality gates before a push. Enable once per clone with:
#   git config core.hooksPath .githooks
#
# Skip for a single push with: git push --no-verify

set -uo pipefail

echo "pre-push: running quality gates (skip with --no-verify)"
if ! "$(git rev-parse --show-toplevel)/tools/gates.sh"; then
	echo
	echo "pre-push: gates failed — push aborted." >&2
	exit 1
fi
